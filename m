-int32_t
-ulp_blob_block_merge(struct ulp_blob *dst, struct ulp_blob *src,
-		     uint32_t block_size, uint32_t pad)
-{
-	if (dst->byte_order == BNXT_ULP_BYTE_ORDER_BE &&
-	    src->byte_order == BNXT_ULP_BYTE_ORDER_BE)
