-	void *h_table;
-	uint32_t entry_size, id;
-	int status;
-
-	/* Check input arguments */
-	status = rte_table_check_params(p, params, table_id);
-	if (status != 0)
-		return status;
-
-	id = p->num_tables;
-	table = &p->tables[id];
