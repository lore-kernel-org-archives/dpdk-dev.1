-		xor[6] = (pkt_key[6] & key_mask[6]) ^ bkt_key[6];		\
-		xor[7] = (pkt_key[7] & key_mask[7]) ^ bkt_key[7];		\
-		or = xor[0] | xor[1] | xor[2] | xor[3] |		\
-			xor[4] | xor[5] | xor[6] | xor[7];		\
-		match_key = 0;						\
-		if (or == 0)						\
-			match_key = 1;					\
-	}								\
-	break;								\
-									\
-	default:							\
-		match_key = 0;						\
-		if (keycmp(bkt_key, pkt_key, key_mask, f->key_size) == 0)	\
