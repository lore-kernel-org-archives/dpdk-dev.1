-			p->ev[p->enq_buf_count++].mbuf = pkt;
-		}
-		send_burst_nodrop(p);
-	} else {
-		for (; pkts_mask;) {
-			uint32_t pkt_index = rte_ctz64(pkts_mask);
-			uint64_t pkt_mask = 1LLU << pkt_index;
