@@ -1349,9 +1352,10 @@ cperf_create_session(struct rte_mempool *sess_mp,
 			return NULL;
 		}
 		return asym_sess;
+	default:
+		break;
 	}
 
-
 #ifdef RTE_LIB_SECURITY
 	/*
 	 * security only
@@ -1672,6 +1676,8 @@ cperf_get_op_functions(const struct cperf_options *options,
