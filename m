-	port_prev = &p->ports_in[port_prev_id];
-	port_next = &p->ports_in[port_next_id];
-
-	port_prev->next = port_next;
-
-	/* Check if the port which has just been disabled is next to serve */
-	if (port == p->port_in_next)
-		p->port_in_next = port_next;
