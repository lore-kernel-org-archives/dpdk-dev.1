+		if (options->asym_op_type != RTE_CRYPTO_ASYM_OP_ENCRYPT &&
+			options->asym_op_type != RTE_CRYPTO_ASYM_OP_DECRYPT) {
 			RTE_LOG(ERR, USER1,
